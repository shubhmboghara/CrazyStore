// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model apps {
  id                 BigInt   @id @default(autoincrement())
  slug               String   @unique
  name               String
  tagline            String?
  category           String?
  version            String?
  updatedAt          String?
  size               String?
  minAndroid         String?
  iconBg             String?
  iconSymbol         String?
  badge              String?
  logoUrl            String?
  bannerUrl          String?
  githubUrl          String?
  techStack          Json?
  downloadUrl        String?
  shortDescription   String?
  fullDescription    Json?
  features           Json?
  createdAt          String?
  initialRating      Decimal?
  initialReviewCount Int?
  screenshots        Json?
}

model reviews {
  id         BigInt   @id @default(autoincrement())
  appSlug    String
  rating     Decimal
  name       String?
  reviewText String
  createdAt  String?
  ip         String?
}
